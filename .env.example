# Google Sheets (Service Account)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Admin credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# WhatsApp (formato internacional sin + ni espacios, ej: 5491122334455)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Site
# En local: http://localhost:3000
# En Vercel: el dominio real del sitio (ej: https://mefale.vercel.app), sin barra final.
# Se usa para el preview de WhatsApp (Open Graph), URLs canónicas y el sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
